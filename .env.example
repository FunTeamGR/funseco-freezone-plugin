# Copy the keys you need into the root .env (Laravel only loads that file).
# true enables the Freezone integration (master switch)
FREEZONE_ENABLED=false
# web service url, user and password
FREEZONE_WS_URL=http://ws.trackmania.com
FREEZONE_WS_USER=
FREEZONE_WS_PASSWORD=
# test mode: no web calls at all
FREEZONE_TESTMODE=false
# kick players the web service bans
FREEZONE_BAN_SYNC=false
# free-account advert in chat
FREEZONE_ADVERT=false
# silent slang telemetry
FREEZONE_SLANG_REPORT=false
# hourly stats POST
FREEZONE_STATS=false
